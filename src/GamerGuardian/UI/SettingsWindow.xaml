<ui:FluentWindow x:Class="GamerGuardian.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GamerGuardian - Settings"
        Closing="OnWindowClosing"
        Width="1150" Height="760"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="GamerGuardian">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Games24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="True">

            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:HyperlinkButton x:Name="VersionLink" Grid.Column="0"
                                    NavigateUri="https://github.com/carterscode/GamerGuardian/releases"
                                    Padding="4,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    FontSize="11"
                                    ToolTip="Open releases page"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="PendingStatusText"
                               Text="No pending changes"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ui:Button x:Name="VerifyAllButton" Content="Verify all" MinWidth="96" Margin="0,0,8,0" Click="VerifyAllButton_Click"
                               ToolTip="Re-read every monitored setting and report the current state vs your preferences in the change log. Does not apply any changes -- safe to click any time."/>
                    <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="CancelButton_Click"
                               ToolTip="Discard every pending change. The committed configuration on disk is not modified."/>
                    <ui:Button x:Name="ApplyButton" Content="Apply" MinWidth="96" Margin="0,0,8,0" Click="ApplyButton_Click"
                               ToolTip="Commit pending changes to disk and run the apply pass. Window stays open."/>
                    <ui:Button x:Name="SaveButton" Content="Save &amp; close" Appearance="Primary" MinWidth="120" Click="SaveButton_Click"
                               ToolTip="Commit pending changes, run the apply pass, then close. If no changes are pending, just closes."/>
                </StackPanel>
            </Grid>

            <ui:NavigationView x:Name="MainNav"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"

                               OpenPaneLength="210">
                <ui:NavigationView.MenuItems>

                    <!-- Pinned above the groups: the drifted count, which is the only
                         status surface (see docs/ui-overhaul.md "Decided against"). -->
                    <ui:NavigationViewItem Content="Status" Tag="status" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Pulse24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="Performance"/>
                    <ui:NavigationViewItem Content="Gaming" Tag="gaming" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Display" Tag="display" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Desktop24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="CPU and power" Tag="cpupower" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DeveloperBoard24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="Privacy"/>
                    <ui:NavigationViewItem Content="Telemetry" Tag="telemetry" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Eye24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Windows AI" Tag="windowsai" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BrainCircuit24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Network" Tag="network" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Globe24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="Cleanup"/>
                    <ui:NavigationViewItem Content="Debloat" Tag="debloat" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Broom24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Services" Tag="services" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Server24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="Reference"/>
                    <ui:NavigationViewItem Content="BIOS" Tag="bios" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                </ui:NavigationView.MenuItems>

                <!-- General sits in the footer, per the recorded navigation decision. -->
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="General" Tag="general" Click="NavItem_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
