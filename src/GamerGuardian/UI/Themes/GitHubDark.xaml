<!--
    GitHub dark (Primer) palette, applied on top of WPF-UI's dark theme.

    WPF-UI's theme dictionary is flat: every key holds a concrete brush rather than
    a reference to a smaller set of primitives, so recolouring the app means
    restating the keys the controls actually read. That is what this file is. It is
    merged *after* ApplicationThemeManager.Apply so it wins on duplicate keys, and
    it is removed again when the user picks the light theme. See ThemeService.

    Colours are the Primer dark tokens GitHub itself ships. They are declared once
    at the top and referenced by name below so the mapping stays readable and a
    palette tweak is a one-line change.

    Adding a key that WPF-UI does not define is harmless; misspelling one is silent,
    so changes here should be checked against a running window rather than a build.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== Primer dark tokens ============================================ -->

    <!-- Surfaces, darkest to lightest. -->
    <Color x:Key="GhCanvasInset">#FF010409</Color>
    <Color x:Key="GhCanvasDefault">#FF0D1117</Color>
    <Color x:Key="GhCanvasSubtle">#FF151B23</Color>
    <Color x:Key="GhCanvasRaised">#FF1C2129</Color>
    <Color x:Key="GhCanvasSunken">#FF12171F</Color>

    <!-- Buttons sit a step above the canvas in Primer. -->
    <Color x:Key="GhBtnBg">#FF212830</Color>
    <Color x:Key="GhBtnHoverBg">#FF262C36</Color>
    <Color x:Key="GhBtnActiveBg">#FF2A313C</Color>

    <Color x:Key="GhBorderDefault">#FF3D444D</Color>
    <Color x:Key="GhBorderMuted">#FF2A3038</Color>

    <Color x:Key="GhFgDefault">#FFF0F6FC</Color>
    <Color x:Key="GhFgMuted">#FF9198A1</Color>
    <Color x:Key="GhFgSubtle">#FF656C76</Color>
    <Color x:Key="GhFgDisabled">#FF484F58</Color>

    <Color x:Key="GhAccentFg">#FF4493F8</Color>
    <Color x:Key="GhAccentEmphasis">#FF1F6FEB</Color>
    <Color x:Key="GhSuccessFg">#FF3FB950</Color>
    <Color x:Key="GhAttentionFg">#FFD29922</Color>
    <Color x:Key="GhDangerFg">#FFF85149</Color>

    <!-- Primer's "subtle" status fills are the emphasis colour at ~15% over the
         canvas, which is why these carry an alpha rather than a solid value. -->
    <Color x:Key="GhAccentSubtle">#261F6FEB</Color>
    <Color x:Key="GhSuccessSubtle">#262EA043</Color>
    <Color x:Key="GhAttentionSubtle">#26BB8009</Color>
    <Color x:Key="GhDangerSubtle">#26F85149</Color>
    <Color x:Key="GhNeutralSubtle">#26656C76</Color>

    <Color x:Key="GhOnEmphasis">#FFFFFFFF</Color>
    <Color x:Key="GhOnEmphasisMuted">#C5FFFFFF</Color>
    <Color x:Key="GhScrim">#99010409</Color>

    <!-- ==== Window and page surfaces ====================================== -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource GhCanvasDefault}"/>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource GhCanvasDefault}"/>
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="LoadingScreenBackground" Color="{StaticResource GhCanvasDefault}"/>
    <SolidColorBrush x:Key="LoadingScreenForeground" Color="{StaticResource GhFgDefault}"/>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource GhCanvasDefault}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource GhCanvasRaised}"/>

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="{StaticResource GhCanvasRaised}"/>

    <!-- ==== Text ========================================================== -->

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource GhFgSubtle}"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{StaticResource GhCanvasDefault}"/>

    <SolidColorBrush x:Key="CardForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="CardForegroundPointerOver" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="CardForegroundPressed" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="CardForegroundDisabled" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="LabelForeground" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ListBoxItemForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TreeViewItemForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TabViewForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TabViewItemForegroundSelected" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="MessageBoxForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="SnackBarForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ContextMenuForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="InfoBarTitleForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="BreadcrumbBarNormalForegroundBrush" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="BreadcrumbBarHoverForegroundBrush" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="{StaticResource GhFgDefault}"/>

    <!-- ==== Cards and expanders =========================================== -->

    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="{StaticResource GhCanvasRaised}"/>
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="CardFooterBackground" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="CardBorderBrushPressed" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="{StaticResource GhBorderMuted}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource GhBorderDefault}"/>

    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="{StaticResource GhBorderMuted}"/>
    <SolidColorBrush x:Key="ExpanderHeaderDisabledForeground" Color="{StaticResource GhFgDisabled}"/>

