    <!-- ==== Buttons ======================================================= -->

    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource GhBtnBg}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource GhBtnHoverBg}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource GhBtnActiveBg}"/>
