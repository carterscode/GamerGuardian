    <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource GhFgSubtle}"/>
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource GhFgDefault}"/>

    <!-- ==== Navigation ==================================================== -->

    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource GhCanvasDefault}"/>
