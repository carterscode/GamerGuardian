    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource GhBtnActiveBg}"/>
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource GhOnEmphasis}"/>

    <!-- Accent-filled surfaces carry white glyphs: Primer's accent blue is much
         darker than WinUI's, and WPF-UI's stock dark theme puts BLACK text on
         accent, which would be unreadable here. -->
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource GhOnEmphasisMuted}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource GhOnEmphasisMuted}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="InfoBadgeValueForeground" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="BadgeForeground" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource GhOnEmphasis}"/>
    <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{StaticResource GhOnEmphasis}"/>

    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource GhAccentFg}"/>
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource GhAccentFg}"/>
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource GhAccentFg}"/>
    <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{StaticResource GhCanvasRaised}"/>
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{StaticResource GhCanvasSunken}"/>

    <!-- ==== Text boxes, combo boxes, pickers ============================== -->

    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource GhBorderMuted}"/>

    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource GhBtnBg}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource GhBtnBg}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource GhBtnHoverBg}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource GhBorderMuted}"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource GhFgDisabled}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource GhCanvasSubtle}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource GhBorderDefault}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource GhBtnHoverBg}"/>

    <SolidColorBrush x:Key="TimePickerButtonBackground" Color="{StaticResource GhBtnBg}"/>
    <SolidColorBrush x:Key="TimePickerButtonBackgroundPointerOver" Color="{StaticResource GhBtnHoverBg}"/>
    <SolidColorBrush x:Key="TimePickerButtonBackgroundPressed" Color="{StaticResource GhBtnActiveBg}"/>
    <SolidColorBrush x:Key="TimePickerButtonForegroundDefault" Color="{StaticResource GhFgDefault}"/>
    <SolidColorBrush x:Key="TimePickerButtonForegroundPointerOver" Color="{StaticResource GhFgDefault}"/>

    <!-- ==== Selection controls ============================================ -->

    <SolidColorBrush x:Key="CheckBoxBackground" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource GhCanvasRaised}"/>

    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{StaticResource GhFgMuted}"/>
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="{StaticResource GhCanvasRaised}"/>

    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource GhCanvasSunken}"/>
