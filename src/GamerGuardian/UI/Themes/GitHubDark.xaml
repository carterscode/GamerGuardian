    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{StaticResource GhFgDisabled}"/>

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource GhCanvasRaised}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource GhCanvasSunken}"/>

    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource GhBorderMuted}"/>
