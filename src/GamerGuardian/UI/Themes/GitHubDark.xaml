    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource GhBtnActiveBg}"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource GhBtnBg}"/>
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource GhCanvasInset}"/>
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource GhCanvasSunken}"/>
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{StaticResource GhCanvasRaised}"/>

