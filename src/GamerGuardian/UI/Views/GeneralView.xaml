<UserControl x:Class="GamerGuardian.UI.Views.GeneralView"              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"              d:DesignHeight="600" d:DesignWidth="760"              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"              mc:Ignorable="d">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,0">
                        <StackPanel>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="One-click setup" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               Text="Stage a whole-config preset in one click, then review the per-tab changes and click Apply / Save &amp; close to commit (or Cancel to discard). All three are idempotent -- they only mutate settings that aren't already where the preset wants them."/>
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run FontWeight="SemiBold" Text="Apply recommended"/><Run Text=" -- GamerGuardian's safe gaming preset: sets the recommended Want, Monitor on, Auto-apply on. Keeps Memory Integrity / VBS on (security) and leaves Privacy / Debloat / contested network tweaks for you to choose. Does not touch your power plan -- set that once yourself on the CPU / Power tab."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run FontWeight="SemiBold" Text="Apply extreme"/><Run Text=" -- everything that could even remotely help gaming, on: every toggle at its most-aggressive value (including Memory Integrity / VBS OFF and the contested Nagle / NIC tweaks), with Monitor AND Auto-apply turned on for every setting. Disabling Memory Integrity / VBS breaks Valorant (Vanguard) and weakens malware protection. Still leaves your power plan alone -- that's a separate one-time setup on the CPU / Power tab."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run FontWeight="SemiBold" Text="Reset all to defaults"/><Run Text=" -- stages every setting back to its Windows default and turns Monitor + Auto-apply off. Applying then restores Windows' shipped behavior (this re-enables features like Copilot, ads and telemetry services you may have turned off). Leaves your power plan as-is -- manage that on the CPU / Power tab."/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <ui:Button Content="Reset all to defaults" MinWidth="150" Margin="0,0,8,0"
                                                   Click="ResetToDefaultsButton_Click"
                                                   ToolTip="Stages every setting back to its Windows default and turns Monitor / Auto-apply off. Review, then Apply / Save &amp; close to commit."/>
                                        <ui:Button Content="Apply recommended" Appearance="Primary" MinWidth="150" Margin="0,0,8,0"
                                                   Click="ApplyRecommendedPresetButton_Click"
                                                   ToolTip="Stages the recommended preset to your draft. Review the per-tab changes, then click Apply / Save &amp; close to commit."/>
                                        <ui:Button Content="Apply extreme" Appearance="Caution" MinWidth="150"
                                                   Click="ApplyExtremePresetButton_Click"
                                                   ToolTip="Stages the most-aggressive gaming preset (including Memory Integrity / VBS off) with Monitor + Auto-apply on for every setting. Review, then Apply / Save &amp; close to commit."/>
                                    </StackPanel>
                                    <TextBlock x:Name="RecommendedStatusText"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="16" Margin="0,0,0,8">
                                <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Theme"/>
                                        <TextBlock Text="Use system, force light, or force dark."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" SelectionChanged="ThemeCombo_SelectionChanged"/>
                                </Grid>

                                <CheckBox x:Name="LaunchAtStartupCheck" Content="Launch at Windows startup" Margin="0,4,0,4"/>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="CheckForUpdatesCheck" Content="Check for updates on startup" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" x:Name="CheckUpdatesNowButton" Content="Check now" MinWidth="110" Click="CheckUpdatesNowButton_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Change log"/>
                                        <TextBlock Text="Every applied change (manual or silent) is recorded with a timestamp, before/after values, and verification status."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Open change log" MinWidth="140" Click="OpenChangeLogButton_Click"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Polling interval"/>
                                        <TextBlock Text="How often the monitor compares current settings against your preferences."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:NumberBox x:Name="PollSecondsBox" Width="120" Minimum="5" Maximum="3600" Value="30"/>
                                        <TextBlock Text="seconds" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
