<!-- Foreground is set on the root because a bare TextBlock defaults to Black:
     nothing above a view supplies one, so any text that is not inside a control
     that sets its own renders black on the dark canvas. Descendants inherit this. -->
<UserControl x:Class="GamerGuardian.UI.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignHeight="600" d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,0">
        <StackPanel>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="DriftHeadlineText"
                                   Text="Everything matches your preferences"
                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DriftSubText"
                                   Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Settings you monitor are checked in the background. Anything that drifts from what you asked for shows up here."/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="DriftCountBadge"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="8" Padding="18,10" VerticalAlignment="Center">
                        <TextBlock x:Name="DriftCountText" Text="0"
                                   FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </Border>
                </Grid>
            </ui:Card>

            <TextBlock Text="This PC" FontWeight="SemiBold" Margin="2,4,0,8"/>
            <ItemsControl x:Name="SystemCardsList" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- A plain Border rather than ui:Card on purpose. Card's
                             template centres its content presenter, so the one-row
                             Memory card floated its header lower than its two-row
                             neighbours and the icons did not line up; Card's default
                             fill is also a 5% white wash that reads as black against
                             this window. A Border stretches to fill the UniformGrid
                             cell, top-aligns its child, and takes an opaque fill. -->
                        <!-- Note ui:Card would also have supplied a Foreground that a
                             bare Border does not; the root of the view now sets it
                             for everything here, so this does not restate it. -->
                        <Border Padding="14" Margin="0,0,8,8" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel VerticalAlignment="Top">
                                <!-- Fixed-height header so all six icons sit on the
                                     same line and the first data row starts at the
                                     same offset in every card. Subtitles are short;
                                     they ellipsize rather than wrap so one long one
                                     cannot push a single card's header taller. -->
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Tinted icon chip: the one visual idea borrowed
                                         wholesale from Sparkle's dashboard. -->
                                    <Border Grid.Column="0"
                                            Background="{Binding AccentBackground}"
                                            CornerRadius="6" Width="34" Height="34"
                                            Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="{Binding Icon}"
                                                       Foreground="{Binding Accent}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Label}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Value}" FontSize="13"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card Padding="16" Margin="0,8,0,12">
                <StackPanel>
                    <TextBlock Text="Drifted by section" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Only monitored settings are counted. Settings set to auto-apply are corrected silently and drop off this list on the next scan."/>
                    <StackPanel x:Name="SectionCountsList" Margin="0,10,0,0"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Monitoring" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PauseStateText"
                                   Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Running."/>
                    </StackPanel>
                    <ui:Button x:Name="PauseToggleButton" Grid.Column="1"
                               Content="Pause monitoring" MinWidth="150"
                               VerticalAlignment="Center"
                               Click="PauseToggleButton_Click"/>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
