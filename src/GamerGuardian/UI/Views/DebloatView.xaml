<UserControl x:Class="GamerGuardian.UI.Views.DebloatView"              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"              d:DesignHeight="600" d:DesignWidth="760"              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"              mc:Ignorable="d">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,0">
                        <StackPanel>
                            <ui:Card Padding="16" Margin="0,0,0,8">
                                <TextBlock Text="Turn off Windows 11's ads, nags, suggested content, and idle background features. Every toggle is reversible and off by default until you opt in. None of these affect Windows Update, security, or networking."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Card>

                            <TextBlock Text="Ads, nags &amp; suggested content"
                                       FontWeight="SemiBold" FontSize="14"
                                       Margin="2,4,0,6"/>
                            <ItemsControl x:Name="DebloatAdsList" Margin="0,0,0,8"
                                          ItemTemplate="{StaticResource ToggleRowTemplate}"/>

                            <TextBlock Text="Background bloat (needs admin to apply)"
                                       FontWeight="SemiBold" FontSize="14"
                                       Margin="2,8,0,6"/>
                            <ItemsControl x:Name="DebloatBackgroundList" Margin="0,0,0,8"
                                          ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
