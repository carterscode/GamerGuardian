<!-- Foreground is set on the root because a bare TextBlock defaults to Black:
     nothing above a view supplies one, so any text that is not inside a control
     that sets its own renders black on the dark canvas. Descendants inherit this. -->
<UserControl x:Class="GamerGuardian.UI.Views.GamingView"              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"              d:DesignHeight="600" d:DesignWidth="760"              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"              mc:Ignorable="d" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,0">
                        <StackPanel>
                            <ItemsControl x:Name="GlobalTogglesList" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="16" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <Border Visibility="{Binding RebootBadgeVisibility}"
                                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                                CornerRadius="3" Padding="6,1"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,4,0,0">
                                                            <TextBlock Text="reboot required"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="12" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding CurrentText}"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       FontSize="11" Margin="0,0,12,2"/>
                                                            <TextBlock Text="{Binding DefaultText}"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       FontSize="11" Margin="0,0,12,2"/>
                                                            <TextBlock Text="{Binding RecommendedText}"
                                                                       Visibility="{Binding RecommendedTextVisibility}"
                                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                                        <CheckBox Content="Monitor" IsChecked="{Binding Monitor}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                            <TextBlock Text="Want:" Margin="0,4,8,0"/>
                                                            <RadioButton GroupName="{Binding GroupName}" Content="{Binding OnLabel}" IsChecked="{Binding DesiredOn}" Margin="0,0,8,0"/>
                                                            <RadioButton GroupName="{Binding GroupName}" Content="{Binding OffLabel}" IsChecked="{Binding DesiredOff}"/>
                                                        </StackPanel>
                                                        <CheckBox Content="Auto-apply silently" IsChecked="{Binding AutoApply}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Expander Header="Learn more" Margin="0,8,0,0"
                                                          Visibility="{Binding LearnMoreVisibility}">
                                                    <TextBox Text="{Binding LearnMoreContent, Mode=OneWay}"
                                                             Style="{StaticResource CopyableLearnMoreText}"
                                                             Margin="8,8,8,8"/>
                                                </Expander>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
