<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
        <!-- Read-only, chrome-free TextBox used to render "Learn more" text so it
             can be selected and copied (a TextBlock can't be) â€” lets users copy the
             PowerShell verify / apply / reverse commands straight out of the panel.
             The custom template drops all TextBox chrome and disables its scrollbars
             so it looks like plain text and doesn't swallow mouse-wheel scrolling. -->
        <Style x:Key="CopyableLearnMoreText" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared row template for the Debloat tab's two sections (same shape
             as the inline toggle templates on the other tabs). -->
        <DataTemplate x:Key="ToggleRowTemplate">
            <ui:Card Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Visibility="{Binding RebootBadgeVisibility}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="3" Padding="6,1"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0">
                                <TextBlock Text="reboot required"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding CurrentText}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11" Margin="0,0,12,2"/>
                                <TextBlock Text="{Binding DefaultText}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11" Margin="0,0,12,2"/>
                                <TextBlock Text="{Binding RecommendedText}"
                                           Visibility="{Binding RecommendedTextVisibility}"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <CheckBox Content="Monitor" IsChecked="{Binding Monitor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="Want:" Margin="0,4,8,0"/>
                                <RadioButton GroupName="{Binding GroupName}" Content="{Binding OnLabel}" IsChecked="{Binding DesiredOn}" Margin="0,0,8,0"/>
                                <RadioButton GroupName="{Binding GroupName}" Content="{Binding OffLabel}" IsChecked="{Binding DesiredOff}"/>
                            </StackPanel>
                            <CheckBox Content="Auto-apply silently" IsChecked="{Binding AutoApply}"/>
                        </StackPanel>
                    </Grid>
                    <Expander Header="Learn more" Margin="0,8,0,0"
                              Visibility="{Binding LearnMoreVisibility}">
                        <TextBox Text="{Binding LearnMoreContent, Mode=OneWay}"
                                 Style="{StaticResource CopyableLearnMoreText}"
                                 Margin="8,8,8,8"/>
                    </Expander>
                </StackPanel>
            </ui:Card>
        </DataTemplate>
</ResourceDictionary>
