<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GamerGuardian</AssemblyName>
    <RootNamespace>GamerGuardian</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <Company>GamerGuardian Contributors</Company>
    <Product>GamerGuardian</Product>
    <Copyright>Copyright (c) 2026 GamerGuardian Contributors</Copyright>

    <!-- Reproducibility: deterministic outputs + portable PDBs.
         When built on GitHub Actions (GITHUB_ACTIONS=true), additional
         normalization kicks in (paths, timestamps) so a CI build at the
         same commit produces byte-identical output across runs. -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <!-- Warnings break the build. Keeps regressions from sneaking in. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Beta channel. Build with `-p:Beta=true` (see .github/workflows/beta.yml) to
       define the BETA constant. A beta build keeps its config, change log and
       diagnostics under a separate root, uses its own mutex and startup entry so it
       can run beside a stable install, shows a BETA marker, and has the whole
       update path compiled out — see Services/AppIdentity.cs.

       A property with a default rather than a fourth Build Configuration: beta
       builds are still Release builds plus one constant, so the Debug/Release
       matrix, the determinism settings, and every publish flag stay as they are.

       Note both paths must compile warning-free on their own, because
       TreatWarningsAsErrors is on and #if-excluded code is invisible to the other
       compile. CI builds both. -->
  <PropertyGroup>
    <Beta Condition="'$(Beta)' == ''">false</Beta>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Beta)' == 'true'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
